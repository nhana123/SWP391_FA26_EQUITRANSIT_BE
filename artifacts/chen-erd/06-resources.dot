digraph G {
graph [rankdir=LR, bgcolor="white", nodesep=0.24, ranksep=1.05, splines=polyline, overlap=false, outputorder=edgesfirst, pad=0.3];
node [fontname="Arial", fontsize=15, margin="0.14,0.10", style=filled];
edge [fontname="Arial", fontsize=12, color="#728095", penwidth=1.2, dir=none, labeldistance=1.8, labelangle=28];
subgraph "cluster_Supplier" { style=invis; margin=16;
"E_Supplier" [shape=box,fillcolor="#555555",color="#353535",fontcolor="white",label="SUPPLIER",width=2.05,height=0.64];
"A_Supplier_0" [shape=ellipse,fillcolor="#124f80",color="#103f65",fontcolor="white",fontsize=12,label=<<U>SupplierID</U>>,width=1.7,height=0.47];
"E_Supplier" -> "A_Supplier_0" [constraint=false,color="#a5b1c4",penwidth=0.85];
"A_Supplier_1" [shape=ellipse,fillcolor="#124f80",color="#103f65",fontcolor="white",fontsize=12,label=<Name>,width=1.7,height=0.47];
"E_Supplier" -> "A_Supplier_1" [constraint=false,color="#a5b1c4",penwidth=0.85];
"A_Supplier_2" [shape=ellipse,fillcolor="#124f80",color="#103f65",fontcolor="white",fontsize=12,label=<ContactName>,width=1.7,height=0.47];
"E_Supplier" -> "A_Supplier_2" [constraint=false,color="#a5b1c4",penwidth=0.85];
{rank=same;"A_Supplier_0";"A_Supplier_1";"E_Supplier";"A_Supplier_2";}
"A_Supplier_0" -> "A_Supplier_1" [style=invis,weight=70];
"A_Supplier_1" -> "E_Supplier" [style=invis,weight=70];
"E_Supplier" -> "A_Supplier_2" [style=invis,weight=70];
}
