"A_DocumentTypeCatalog_0" -> "A_DocumentTypeCatalog_1" [style=invis,weight=70];
"A_DocumentTypeCatalog_1" -> "E_DocumentTypeCatalog" [style=invis,weight=70];
"E_DocumentTypeCatalog" -> "A_DocumentTypeCatalog_2" [style=invis,weight=70];
}
