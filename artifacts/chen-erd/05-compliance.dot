digraph G {
graph [rankdir=LR, bgcolor="white", nodesep=0.24, ranksep=1.05, splines=polyline, overlap=false, outputorder=edgesfirst, pad=0.3];
node [fontname="Arial", fontsize=15, margin="0.14,0.10", style=filled];
edge [fontname="Arial", fontsize=12, color="#728095", penwidth=1.2, dir=none, labeldistance=1.8, labelangle=28];
subgraph "cluster_DocumentTypeCatalog" { style=invis; margin=16;
"E_DocumentTypeCatalog" [shape=box,fillcolor="#555555",color="#353535",fontcolor="white",label="DOCUMENT TYPE CATALOG",width=2.05,height=0.64];
"A_DocumentTypeCatalog_0" [shape=ellipse,fillcolor="#124f80",color="#103f65",fontcolor="white",fontsize=12,label=<<U>TypeCode</U>>,width=1.7,height=0.47];
