# Documentation only: Spring does not automatically load this file.
# Set these values as environment variables for the deployment profile.
# Local Windows development uses run-local.ps1 and its ignored random key.
EQ_DB_URL=jdbc:sqlserver://YOUR_SERVER:1433;databaseName=EquiTransit;encrypt=true;trustServerCertificate=false
EQ_DB_USERNAME=YOUR_DATABASE_LOGIN
EQ_DB_PASSWORD=YOUR_DATABASE_PASSWORD
EQ_JWT_SECRET=BASE64_OF_AT_LEAST_32_RANDOM_BYTES
EQ_SMTP_HOST=YOUR_SMTP_HOST
EQ_SMTP_PORT=587
EQ_SMTP_USERNAME=YOUR_SMTP_USERNAME
EQ_SMTP_PASSWORD=YOUR_SMTP_PASSWORD
EQ_MAIL_FROM=YOUR_VERIFIED_SENDER
EQ_FRONTEND_URL=http://localhost:5173
EQ_CORS_ORIGIN=http://localhost:5173
